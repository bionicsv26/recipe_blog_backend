generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URI")
}

enum Role {
  USER
  CHEF
  MODERATOR
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String  @map("password_hash")
  role         Role    @default(USER)
  isActive     Boolean @default(true) @map("is_active")

  profile Profile?
  recipes Recipe[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@map("users")
}

model Profile {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  username  String  @unique
  bio       String?
  avatarUrl String? @map("avatar_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

model Recipe {
  id            String  @id @default(uuid())
  title         String
  slug          String  @unique
  description   String? @db.VarChar(500)
  coverImageUrl String? @map("cover_image_url")

  // Кулинарные метрики
  prepTime    Int?       @map("prep_time") // время подготовки (в минутах)
  cookTime    Int        @map("cook_time") // время готовки (в минутах)
  servings    Int        @default(1) // количество порций
  difficulty  Difficulty @default(MEDIUM)
  isPublished Boolean    @default(false) @map("is_published")

  authorId String @map("author_id")
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Связи
  ingredients RecipeIngredient[]
  steps       RecipeStep[]
  images      RecipeImage[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([authorId])
  @@index([isPublished])
  @@map("recipes")
}

model RecipeIngredient {
  id       String @id @default(uuid())
  recipeId String @map("recipe_id")
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  name   String // "Мука пшеничная"
  amount Decimal @db.Decimal(10, 2) // 250.00
  unit   String // "г", "мл", "ст. л.", "шт"
  note   String? // "просеянная"
  order  Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([recipeId])
  @@index([name])
  @@map("recipe_ingredients")
}

// Пошаговое приготовление
model RecipeStep {
  id       String @id @default(uuid())
  recipeId String @map("recipe_id")
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  stepNumber  Int     @map("step_number") // 1, 2, 3...
  instruction String  @db.Text // описание шага
  imageUrl    String? @map("image_url") // опциональное фото конкретного шага

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([recipeId, stepNumber])
  @@index([recipeId])
  @@map("recipe_steps")
}

// Дополнительная галерея готового блюда
model RecipeImage {
  id       String @id @default(uuid())
  recipeId String @map("recipe_id")
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  url     String // CDN / S3 url
  caption String? // подпись
  order   Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([recipeId])
  @@map("recipe_images")
}
