# --- Приложение ---
# development | production | test
NODE_ENV=development
PORT=3000

# --- PostgreSQL ---
# Эти переменные использует docker-compose для контейнера
# и интерполяции в POSTGRES_URI (ConfigModule: expandVariables).
POSTGRES_USER=root
POSTGRES_PASSWORD=your_password
POSTGRES_HOST=localhost
POSTGRES_DB=recipe-blog
POSTGRES_PORT=5434

# Prisma читает именно POSTGRES_URI (schema.prisma: env("POSTGRES_URI")).
# Спецсимволы в пароле (@ : / ? #) должны быть URL-encoded.
POSTGRES_URI="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# --- Redis ---
# Поднимается по умолчанию: docker compose up -d
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=87654321

# --- JWT ---
# Секреты ОБЯЗАНЫ различаться. Минимум 16 символов, рекомендуется 32+.
# Сгенерировать: openssl rand -hex 32
JWT_ACCESS_SECRET="your-super-secret-access-key-change-in-production"
# секунды: 900 = 15 минут
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
# секунды: 604800 = 7 дней
JWT_REFRESH_EXPIRATION=604800

# --- Почта (SMTP) ---
# Вариант A: реальный провайдер.
# 465 = SSL, остальные порты = STARTTLS.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
# Допустим формат с отображаемым именем: "Recipe Blog <noreply@example.com>".
# Домен должен быть вашим / разрешённым провайдером, иначе SPF/DKIM не пройдут.
SMTP_FROM="Recipe Blog <noreply@example.com>"

# Вариант B: локальный перехват писем (MailHog, профиль test):
#   docker compose --profile test up -d mailhog
#   SMTP_HOST=localhost
#   SMTP_PORT=1025
#   SMTP_USER=
#   SMTP_PASSWORD=
# Просмотр писем: http://localhost:8025

# S3 / RustFS (S3-совместимое хранилище)
# Console: http://localhost:9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=recipe-media
# Публичный префикс URL объектов. Должен совпадать с тем, что записано в БД,
# иначе extractKeyFromUrl не сопоставит ключи (см. MEDIA-07 в AUDIT.md).
S3_PUBLIC_URL=http://localhost:9000/recipe-media
# Строка 'true' или 'false' — MediaService сравнивает со строкой, не с boolean.
S3_USE_SSL=false

# --- Frontend ---
# Используется в ссылках писем; с PR3 — также whitelist CORS.
FRONTEND_URL="http://localhost:5173"